SARVAM_API_KEY=your_sarvam_subscription_key
ANTHROPIC_API_KEY=your_anthropic_key

# Conversation defaults
LANGUAGE_CODE=en-IN
TTS_SPEAKER=ritu

# Zoho CRM -- Server URL from Zoho MCP dashboard -> Connect.
# The API key is inside the path, so treat this whole URL as a secret.
ZOHO_MCP_URL=https://crm-data-metadata-<org>.zohomcp.com/mcp/<api-key>/message

# Needed only for user-scoped keys (sk-ant-usr-...): the workspace to bill/run in.
ANTHROPIC_WORKSPACE_ID=
